{ parameter
    (or (pair %mint nat address)
        (or (list %update_operators
               (or (pair %add_operator (address %owner) (pair (address %operator) (nat %token_id)))
                   (pair %remove_operator (address %owner) (pair (address %operator) (nat %token_id)))))
            (or (pair %balance_of
                   (list %requests (pair (address %owner) (nat %token_id)))
                   (contract %callback
                      (list (pair (pair %request (address %owner) (nat %token_id)) (nat %balance)))))
                (list %transfer
                   (pair (address %from_)
                         (list %txs (pair (address %to_) (pair (nat %token_id) (nat %amount))))))))) ;
  storage
    (pair (address %admin)
          (pair (big_map %ledger nat address)
                (pair (big_map %operators (pair address (pair address nat)) unit)
                      (pair (big_map %token_metadata nat (pair (nat %token_id) (map %token_info string bytes)))
                            (big_map %metadata string bytes))))) ;
  code { UNPAIR ;
         IF_LEFT
           { UNPAIR ;
             DUP 3 ;
             CAR ;
             SENDER ;
             COMPARE ;
             NEQ ;
             IF { PUSH string "NOT_ADMIN" ; FAILWITH }
                { DUP 3 ;
                  GET 3 ;
                  DUP 2 ;
                  MEM ;
                  IF { PUSH string "TOKEN_EXISTS" ; FAILWITH }
                     { DUP 3 ;
                       DUP 4 ;
                       GET 3 ;
                       DIG 3 ;
                       SOME ;
                       DUP 4 ;
                       UPDATE ;
                       UPDATE 3 ;
                       DIG 2 ;
                       GET 7 ;
                       PUSH (map string bytes) { Elt "name" 0x54657374204e4654 } ;
                       DUP 4 ;
                       PAIR ;
                       SOME ;
                       DIG 3 ;
                       UPDATE ;
                       UPDATE 7 ;
                       NIL operation ;
                       PAIR } } }
           { IF_LEFT
               { DUP 2 ;
                 GET 5 ;
                 SWAP ;
                 ITER { IF_LEFT
                          { SENDER ;
                            DUP 2 ;
                            CAR ;
                            COMPARE ;
                            NEQ ;
                            IF { PUSH string "FA2_NOT_OWNER" ; FAILWITH }
                               { SWAP ; UNIT ; SOME ; DIG 2 ; UPDATE } }
                          { SENDER ;
                            DUP 2 ;
                            CAR ;
                            COMPARE ;
                            NEQ ;
                            IF { PUSH string "FA2_NOT_OWNER" ; FAILWITH }
                               { SWAP ; NONE unit ; DIG 2 ; UPDATE } } } ;
                 UPDATE 5 ;
                 NIL operation }
               { IF_LEFT
                   { DUP ;
                     CAR ;
                     MAP { DUP ;
                           CAR ;
                           DUP 4 ;
                           GET 3 ;
                           DUP 3 ;
                           CDR ;
                           GET ;
                           IF_NONE { PUSH string "FA2_TOKEN_UNDEFINED" ; FAILWITH } {} ;
                           COMPARE ;
                           EQ ;
                           IF { PUSH nat 1 } { PUSH nat 0 } ;
                           SWAP ;
                           PAIR } ;
                     DIG 2 ;
                     NIL operation ;
                     DIG 3 ;
                     CDR ;
                     PUSH mutez 0 ;
                     DIG 4 ;
                     TRANSFER_TOKENS ;
                     CONS }
                   { SENDER ;
                     DUP 3 ;
                     GET 3 ;
                     DIG 2 ;
                     ITER { SWAP ;
                            DUP 2 ;
                            CDR ;
                            ITER { SWAP ;
                                   PUSH nat 0 ;
                                   DUP 3 ;
                                   GET 4 ;
                                   COMPARE ;
                                   EQ ;
                                   IF { SWAP ; DROP }
                                      { PUSH nat 1 ;
                                        DUP 3 ;
                                        GET 4 ;
                                        COMPARE ;
                                        NEQ ;
                                        IF { PUSH string "FA2_INSUFFICIENT_BALANCE" ; FAILWITH }
                                           { DUP ;
                                             DUP 3 ;
                                             GET 3 ;
                                             GET ;
                                             IF_NONE { PUSH string "FA2_TOKEN_UNDEFINED" ; FAILWITH } {} ;
                                             DUP 4 ;
                                             CAR ;
                                             COMPARE ;
                                             NEQ ;
                                             IF { PUSH string "FA2_INSUFFICIENT_BALANCE" ; FAILWITH }
                                                { DUP 5 ;
                                                  GET 5 ;
                                                  DUP 3 ;
                                                  GET 3 ;
                                                  DUP 6 ;
                                                  DUP 6 ;
                                                  CAR ;
                                                  PAIR 3 ;
                                                  MEM ;
                                                  NOT ;
                                                  DUP 4 ;
                                                  CAR ;
                                                  DUP 6 ;
                                                  COMPARE ;
                                                  NEQ ;
                                                  AND ;
                                                  IF { PUSH string "FA2_NOT_OPERATOR" ; FAILWITH }
                                                     { DUP 2 ; CAR ; SOME ; DIG 2 ; GET 3 ; UPDATE } } } } } ;
                            SWAP ;
                            DROP } ;
                     SWAP ;
                     DROP ;
                     UPDATE 3 ;
                     NIL operation } } ;
             PAIR } } }

